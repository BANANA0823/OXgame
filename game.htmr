<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>4目落とし</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    min-height: 100vh;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: linear-gradient(135deg, #eef7ff, #fff8e8);
    color: #333;
    display: flex;
    justify-content: center;
    align-items: center;
}

.game-container {
    width: 100%;
    max-width: 720px;
    padding: 20px;
}

/* タイトル */
h1 {
    text-align: center;
    margin: 0 0 10px;
    font-size: clamp(28px, 7vw, 46px);
}

/* 説明 */
.description {
    text-align: center;
    margin-bottom: 15px;
    color: #666;
}

/* ターン表示 */
.turn-box {
    background: white;
    border-radius: 18px;
    padding: 15px;
    text-align: center;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    margin-bottom: 15px;
}

.turn-label {
    font-size: 15px;
    color: #777;
}

#turnDisplay {
    font-size: clamp(28px, 8vw, 42px);
    font-weight: bold;
    margin-top: 3px;
}

/* プレイヤー一覧 */
.players {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 15px;
}

.player {
    background: white;
    border-radius: 12px;
    padding: 8px 4px;
    text-align: center;
    box-shadow: 0 3px 8px rgba(0,0,0,0.08);
    font-size: 14px;
}

.player-symbol {
    font-size: 25px;
    font-weight: bold;
}

/* ゲーム盤 */
.board-wrapper {
    background: #3978c9;
    padding: 10px;
    border-radius: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.18);
}

/* 8列 */
.board {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 7px;
}

/* マス */
.cell {
    aspect-ratio: 1 / 1;
    background: #dceeff;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    user-select: none;

    font-size: clamp(22px, 7vw, 48px);
    font-weight: bold;

    transition:
        transform 0.12s,
        background 0.12s;
}

.cell:hover {
    background: #c7e5ff;
    transform: scale(1.04);
}

.cell:active {
    transform: scale(0.94);
}

/* 記号 */
.circle {
    color: #e53935;
}

.cross {
    color: #1976d2;
}

.triangle {
    color: #43a047;
}

.square {
    color: #8e24aa;
}

/* 落ちるアニメーション */
.drop {
    animation: dropAnimation 0.3s ease-out;
}

@keyframes dropAnimation {
    0% {
        transform: translateY(-40px);
        opacity: 0;
    }

    100% {
        transform: translateY(0);
        opacity: 1;
    }
}

/* 操作説明 */
.hint {
    text-align: center;
    margin: 15px 0;
    color: #666;
}

/* リセットボタン */
button {
    width: 100%;
    height: 50px;
    border: none;
    border-radius: 14px;
    background: #333;
    color: white;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

button:hover {
    background: #555;
}

button:active {
    transform: scale(0.97);
}

/* 勝利画面 */
#resultOverlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.65);

    display: none;
    justify-content: center;
    align-items: center;

    z-index: 1000;
    padding: 20px;
}

.result-box {
    background: white;
    width: 100%;
    max-width: 420px;
    border-radius: 25px;
    padding: 35px 25px;
    text-align: center;

    animation: resultPop 0.35s ease;
}

@keyframes resultPop {
    0% {
        transform: scale(0.5);
        opacity: 0;
    }

    100% {
        transform: scale(1);
        opacity: 1;
    }
}

#resultText {
    font-size: clamp(32px, 10vw, 50px);
    font-weight: bold;
    margin-bottom: 25px;
}

.win-message {
    color: #ff9800;
}

.draw-message {
    color: #555;
}

/* スマホ */
@media (max-width: 500px) {

    .game-container {
        padding: 12px;
    }

    .board-wrapper {
        padding: 7px;
    }

    .board {
        gap: 4px;
    }

    .players {
        gap: 4px;
    }

    .player {
        font-size: 12px;
    }
}
</style>
</head>

<body>

<div class="game-container">

    <h1>⭕ 4目落とし ⭕</h1>

    <div class="description">
        8×6マス・4人対戦
    </div>

    <!-- ターン表示 -->
    <div class="turn-box">

        <div class="turn-label">
            現在のターン
        </div>

        <div id="turnDisplay">
            プレイヤー1「〇」
        </div>

    </div>

    <!-- プレイヤー -->
    <div class="players">

        <div class="player">
            <div class="player-symbol circle">〇</div>
            P1
        </div>

        <div class="player">
            <div class="player-symbol cross">×</div>
            P2
        </div>

        <div class="player">
            <div class="player-symbol triangle">△</div>
            P3
        </div>

        <div class="player">
            <div class="player-symbol square">□</div>
            P4
        </div>

    </div>

    <!-- ゲーム盤 -->
    <div class="board-wrapper">
        <div id="board" class="board"></div>
    </div>

    <div class="hint">
        👆 入れたい列をタップ！
    </div>

    <button onclick="resetGame()">
        🔄 ゲームをリセット
    </button>

</div>


<!-- 勝利画面 -->
<div id="resultOverlay">

    <div class="result-box">

        <div id="resultText"></div>

        <button onclick="resetGame()">
            🔄 もう一回遊ぶ
        </button>

    </div>

</div>


<script>

/* =====================================
   🎮 ゲーム設定
===================================== */

const ROWS = 6;
const COLS = 8;


/* =====================================
   👥 プレイヤー
===================================== */

const players = [

    {
        name: "プレイヤー1",
        symbol: "〇",
        className: "circle"
    },

    {
        name: "プレイヤー2",
        symbol: "×",
        className: "cross"
    },

    {
        name: "プレイヤー3",
        symbol: "△",
        className: "triangle"
    },

    {
        name: "プレイヤー4",
        symbol: "□",
        className: "square"
    }

];


/* =====================================
   ゲームデータ
===================================== */

let board = [];

let currentPlayer = 0;

let gameOver = false;


/* =====================================
   🎮 ゲーム開始
===================================== */

function initGame() {

    board = [];

    for (let row = 0; row < ROWS; row++) {

        board[row] = [];

        for (let col = 0; col < COLS; col++) {

            board[row][col] = null;

        }

    }

    currentPlayer = 0;

    gameOver = false;

    document.getElementById("resultOverlay").style.display = "none";

    createBoard();

    updateTurn();

}


/* =====================================
   🧱 盤面を作る
===================================== */

function createBoard() {

    const boardElement =
        document.getElementById("board");

    boardElement.innerHTML = "";


    for (let row = 0; row < ROWS; row++) {

        for (let col = 0; col < COLS; col++) {

            const cell =
                document.createElement("div");

            cell.className = "cell";

            cell.dataset.row = row;
            cell.dataset.col = col;

            /*
               列をクリックしたら
               コマを落とす
            */

            cell.addEventListener(
                "click",
                () => {

                    dropPiece(col);

                }
            );

            boardElement.appendChild(cell);

        }

    }

}


/* =====================================
   👆 コマを落とす
===================================== */

function dropPiece(col) {

    if (gameOver) {
        return;
    }


    /*
       下から空いている場所を探す
    */

    let targetRow = -1;


    for (
        let row = ROWS - 1;
        row >= 0;
        row--
    ) {

        if (board[row][col] === null) {

            targetRow = row;

            break;

        }

    }


    /*
       列がいっぱい
    */

    if (targetRow === -1) {

        return;

    }


    /*
       コマを置く
    */

    board[targetRow][col] =
        currentPlayer;


    renderBoard();


    /*
       勝利チェック
    */

    if (
        checkWin(
            targetRow,
            col,
            currentPlayer
        )
    ) {

        endGame(
            players[currentPlayer].symbol +
            "の勝ち！"
        );

        return;

    }


    /*
       全部埋まった？
    */

    if (isBoardFull()) {

        endGame("引き分け！");

        return;

    }


    /*
       次のプレイヤー
    */

    currentPlayer++;

    if (
        currentPlayer >= players.length
    ) {

        currentPlayer = 0;

    }


    updateTurn();

}


/* =====================================
   🖥️ 盤面表示
===================================== */

function renderBoard() {

    const cells =
        document.querySelectorAll(".cell");


    cells.forEach(cell => {

        const row =
            Number(cell.dataset.row);

        const col =
            Number(cell.dataset.col);


        cell.textContent = "";

        cell.className = "cell";


        if (
            board[row][col] !== null
        ) {

            const player =
                players[board[row][col]];


            cell.textContent =
                player.symbol;


            cell.classList.add(
                player.className
            );

            cell.classList.add("drop");

        }

    });

}


/* =====================================
   🔍 4個並んだか確認
===================================== */

function checkWin(
    row,
    col,
    player
) {

    /*
       縦
    */

    if (
        countDirection(
            row,
            col,
            1,
            0,
            player
        ) >= 4
    ) {

        return true;

    }


    /*
       横
    */

    if (
        countDirection(
            row,
            col,
            0,
            1,
            player
        ) >= 4
    ) {

        return true;

    }


    /*
       右下↘ ＋ 左上↖
    */

    if (
        countDirection(
            row,
            col,
            1,
            1,
            player
        ) +
        countDirection(
            row,
            col,
            -1,
            -1,
            player
        ) -
        1 >= 4
    ) {

        return true;

    }


    /*
       左下↙ ＋ 右上↗
    */

    if (
        countDirection(
            row,
            col,
            1,
            -1,
            player
        ) +
        countDirection(
            row,
            col,
            -1,
            1,
            player
        ) -
        1 >= 4
    ) {

        return true;

    }


    return false;

}


/* =====================================
   🔢 同じ記号を数える
===================================== */

function countDirection(
    row,
    col,
    rowDirection,
    colDirection,
    player
) {

    let count = 1;


    let r =
        row + rowDirection;

    let c =
        col + colDirection;


    while (
        r >= 0 &&
        r < ROWS &&
        c >= 0 &&
        c < COLS &&
        board[r][c] === player
    ) {

        count++;

        r += rowDirection;
        c += colDirection;

    }


    return count;

}


/* =====================================
   📦 盤面が全部埋まったか
===================================== */

function isBoardFull() {

    for (let col = 0; col < COLS; col++) {

        if (board[0][col] === null) {

            return false;

        }

    }

    return true;

}


/* =====================================
   👤 ターン表示
===================================== */

function updateTurn() {

    const player =
        players[currentPlayer];


    const display =
        document.getElementById(
            "turnDisplay"
        );


    display.textContent =
        player.name +
        "「" +
        player.symbol +
        "」の番";


    display.className =
        player.className;

}


/* =====================================
   🏆 ゲーム終了
===================================== */

function endGame(message) {

    gameOver = true;


    const resultText =
        document.getElementById(
            "resultText"
        );


    resultText.textContent =
        message;


    if (message === "引き分け！") {

        resultText.className =
            "draw-message";

    }
    else {

        resultText.className =
            "win-message";

    }


    document.getElementById(
        "resultOverlay"
    ).style.display = "flex";

}


/* =====================================
   🔄 リセット
===================================== */

function resetGame() {

    initGame();

}


/* =====================================
   🚀 起動
===================================== */

initGame();

</script>

</body>
</html>
